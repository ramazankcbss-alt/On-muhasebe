rules_version = '2';
// Firebase konsolu → Firestore Database → Kurallar sekmesine yapıştırın.
// Sadece giriş yapmış kullanıcılar (yöneticinin Authentication'a eklediği hesaplar) okuyup yazabilir.
service cloud.firestore {
  match /databases/{database}/documents {
    match /sirketler/kones/kayitlar/{kayit} {
      allow read, write: if request.auth != null;
    }
  }
}
